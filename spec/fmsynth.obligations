# fmsynth.obligations — disposition for every `allium plan` obligation of fmsynth.allium.
#   <id> => structural | test:<name> exercises=<symbol> | waived: <reason>
# The voice-allocation decision (which voice a note-on sounds, which a note-off releases,
# the drum-channel classification) is pure (fmvoice.h) and unit-tested by
# tests/fmvoice_test.c; the driver's Opl3_FindEmptySlot/Opl3_FindFullSlot delegate to it.

# --- Spec-integrity (covered by the check/analyse lane) ---
config-default.voice_count       => test:test_fm_allocate exercises=FmVoiceAllocate
config-default.drum_channel      => test:test_fm_drum_channel exercises=FmVoiceIsDrum
entity-fields.Note               => structural
entity-fields.Voice              => structural
transition-rejected.Voice.state  => structural
transition-terminal.Voice.state  => structural
surface-actor.FmSynth            => structural
surface-provides.FmSynth         => structural

# --- Behavioural (discharged by the pure voice allocator, tests/fmvoice_test.c) ---
transition-edge.Voice.free.sounding    => test:test_fm_allocate exercises=FmVoiceAllocate
transition-edge.Voice.sounding.free    => test:test_fm_find exercises=FmVoiceFind
rule-success.DrumChannelIsPercussion   => test:test_fm_drum_channel exercises=FmVoiceIsDrum
rule-failure.DrumChannelIsPercussion.1 => test:test_fm_drum_channel exercises=FmVoiceIsDrum
rule-success.NoteOnSounds              => test:test_fm_allocate exercises=FmVoiceAllocate
rule-success.NoteOffReleases           => test:test_fm_find exercises=FmVoiceFind
invariant.VoiceBudget                  => test:test_fm_allocate exercises=FmVoiceAllocate
rule-success.FreshStreamAllVoicesFree  => test:test_fm_allocate exercises=FmVoiceAllocate
