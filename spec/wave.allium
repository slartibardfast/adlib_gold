-- allium: 3
-- adlib_gold wave: the WaveCyclic render path over the YMZ263 (MMA) digital audio.
-- A render stream accepts a PCM format, moves through the KS transport states, and
-- plays its buffer to the 12-bit DAC: 8-bit over ISA DMA, 16-bit dithered to 12 bits
-- over PIO, and an off-rate source resampled to a supported hardware rate. Distilled
-- from algwave.cpp; the chip timing figures live in the .tla timing spec.

config {
    -- The discrete sample rates the MMA clocks, in Hz (SDK; algwave.h).
    rate_high: Integer = 44100
    rate_upper_mid: Integer = 22050
    rate_lower_mid: Integer = 11025
    rate_low: Integer = 7350
    -- FIFO interrupt threshold in bytes the refill DPC leaves in hand.
    fifo_threshold: Integer = 32
}

given {
    stream: Stream
}

enum BitDepth {
    pcm8
    pcm16
}

enum ChannelCount {
    mono
    stereo
}

-- A requested PCM render format. requested_rate is what Windows asks for; it need not
-- be a hardware rate, and then the stream resamples to the nearest supported rate.
entity Format {
    bits: BitDepth
    channels: ChannelCount
    pcm_subtype: Boolean
    requested_rate: Integer
    resampled: Boolean
    resample_bounded: Boolean
    dithered: Boolean
    routes_both_outputs: Boolean
    interleaved: Boolean
}

-- One render stream across its KS transport lifecycle. ACQUIRE folds to PAUSE.
entity Stream {
    format: Format?
    position: Integer
    state: stopped | paused | running

    transitions state {
        stopped -> paused
        paused -> running
        running -> paused
        paused -> stopped
        running -> stopped
        terminal: stopped
    }

    -- The DAC clocks only while a configured stream is running.
    invariant RunningIsConfigured {
        state = running implies format != none
    }
}

-- The YMZ263 raises one shared sampling interrupt; the MMA status register (a direct
-- read of base+4, manual ch07) says which source needs service, and the pure
-- mmastatus.h is the one tested decode of that byte, so a mislabeled bit can no
-- longer silence playback. A PIO stream services on the channel-0 FIFO request. A
-- DMA-transport stream services on the Timer-0 elapse: the FIFO threshold interrupt
-- never fires while auto-initialize DMA keeps the FIFO fed, so the timer is the
-- service clock (call/0034; the liveness argument is NotifyLiveness.tla).
entity MmaService {
    playback_fifo_ready: Boolean
    timer_elapsed: Boolean
    render_serviced: Boolean
    position_advanced: Boolean
}

-- The PnP-assigned DMA channel programmed into the control chip, validated to a channel
-- the 2-bit select field can hold before use.
entity DmaConfig {
    validated: Boolean
}

-- The KS wave-render boundary the port class drives.
surface WaveRender {
    facing stream: Stream
    provides:
        Started(stream)
        Paused(stream)
        Stopped(stream)
        PositionRead(stream)
}

-- A format is accepted as audio PCM, 8 or 16 bit; the port class refuses a non-PCM
-- subtype before a stream is configured. Both mono and stereo are accepted: stereo runs
-- the dual-channel interleaved DMA path (call/0017, superseding call/0016).
rule AcceptPcmFormat {
    when: format: Format.created
    requires: format.pcm_subtype
    ensures: stream.format = format
}

-- A mono stream drives its one FIFO to both outputs (reg 09h L and R set) with interleave
-- off (reg 0Ch ILV clear), the routing the pure wavereg.h helper derives from the channel
-- count. The mapping is the one tested source of truth, so a regression that ignores the
-- channel count is caught.
rule MonoRoutesBothOutputs {
    when: format: Format.created
    requires: format.channels = mono
    ensures: format.routes_both_outputs = true
}

-- A stereo stream splits its channels across the outputs and interleaves them: the
-- wavereg.h helper maps channel 0 to the right output and channel 1 to the left, and sets
-- the reg-0Ch interleave bit on channel 0, matching the validated reference (call/0017).
-- The mapping is the one tested source of truth, so a change that swaps or drops a channel
-- is caught.
rule StereoInterleavesChannels {
    when: format: Format.created
    requires: format.channels = stereo
    ensures: format.interleaved = true
}

-- A source rate that is not one of the four hardware rates is resampled to the nearest
-- one (call/0011). The skeleton rejects it today; the spec leads, and plan/0004 closes
-- the gap.
rule ResampleOffRate {
    when: format: Format.created
    requires: not (format.requested_rate = config.rate_high
        or format.requested_rate = config.rate_upper_mid
        or format.requested_rate = config.rate_lower_mid
        or format.requested_rate = config.rate_low)
    ensures: format.resampled = true
}

-- The off-rate resampler walks its input with a Q16 phase accumulator, so an unbounded
-- block would wrap the accumulator and corrupt the read index. Each resample is bounded
-- to a safe block; the arithmetic bound is the one tested source of truth
-- (WaveSrcResample), so a change that drops the guard is caught before it ships silence.
rule ResampleBoundedBlock {
    when: format: Format.created
    requires: format.resampled
    ensures: format.resample_bounded = true
}

-- A 16-bit source is dithered down to the 12-bit DAC with triangular-PDF dither, so
-- the quantization error is noise rather than distortion (call/0011).
rule DitherWideFormat {
    when: format: Format.created
    requires: format.bits = pcm16
    ensures: format.dithered = true
}

-- Running starts the DAC; RUN programs the MMA and starts playback.
rule StartRender {
    when: stream: Stream.state transitions_to running
    requires: stream.format != none
    ensures: Started(stream)
}

-- Pausing stops the engine and masks the FIFO interrupt.
rule PauseRender {
    when: stream: Stream.state transitions_to paused
    ensures: Paused(stream)
}

-- Position is read while running, and never runs backward within a run.
rule ReadPosition {
    when: PositionRead(stream)
    requires: stream.state = running
    ensures: stream.position >= 0
}

-- A PIO render stream is refilled when the channel-0 FIFO signals it has reached its
-- interrupt level. The decode is the one tested source of truth: the driver's ISR gates
-- the render service on this bit, so a status-bit mislabel is caught by the test.
rule PlaybackFifoServicesRender {
    when: service: MmaService.created
    requires: service.playback_fifo_ready
    ensures: service.render_serviced = true
}

-- A DMA-transport stream is serviced when Timer 0 elapses (call/0034): the ISR re-arms
-- the timer (the status flags are level-sensitive, so the re-arm is what drops the line
-- for the next edge) and notifies. The decode is the one tested source of truth.
rule TimerServicesDmaRender {
    when: service: MmaService.created
    requires: service.timer_elapsed
    ensures: service.render_serviced = true
}

-- A serviced stream advances its cyclic buffer position by the bytes moved, wrapping at
-- the buffer end, so the reported position moves forward while running and never reads
-- past the buffer. The wrap arithmetic is the one tested source of truth (WaveWrapPosition).
rule ServiceAdvancesPosition {
    when: service: MmaService.created
    requires: service.render_serviced
    ensures: service.position_advanced = true
}

-- The DMA channel is validated to a supported channel before it is programmed; an
-- out-of-range channel falls back rather than masking to a wrong channel. The mapping is
-- the pure tested WaveDmaSelectBits, so a change that drops the check is caught, mirroring
-- the IRQ validation.
rule DmaChannelValidated {
    when: cfg: DmaConfig.created
    ensures: cfg.validated = true
}
