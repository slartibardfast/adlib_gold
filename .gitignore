
# Reproducible-build output: the driver binary and the transient Wine prefix are
# regenerated by build.sh from the pinned source, so they are never tracked (the
# expected hash lives in .host-software and reproducible-build.yml).
adlibgold.sys
adlibgold.chk.sys
.winebuild/

# TLC (Specula lane) transient output — regenerated per run, never tracked.
# (tla2tools.jar is vendored at spec/tla2tools.jar — tracked, the immutable pin.)
spec/states/
spec/*_TTrace_*.tla
spec/*_TTrace_*.bin
