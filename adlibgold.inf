;
; Module Name:
;    adlibgold.INF
;
; Abstract:
;    INF file for installing the Ad Lib Gold WDM Audio Driver
;
; Installation:
;    The Ad Lib Gold is a non-PnP ISA card (predates ISA PnP).
;    Install via Add Hardware Wizard -> Have Disk -> point to this INF.

[Version]
Signature="$CHICAGO$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
provider=%MfgName%
DriverVer=08/02/1999,1.00.0000.9

[SourceDisksNames.x86]
222=%DiskDescription%,,,

[SourceDisksFiles.x86]
adlibgold.sys=222

[Manufacturer]
%MfgName%=AdLibGold

[ControlFlags]

;;
;; The Ad Lib Gold is a non-PnP ISA card.
;; ALG1000 is a vendor-assigned device ID for manual installation.
;;
[AdLibGold]
;; Model matrix: pick the card you have. All share one install section; the driver
;; auto-detects the exact model and the surround module at runtime. Resource ranges
;; (both the Gold 1000 and Gold 2000 DMA/IRQ sets) are offered by the LogConfigs below.
%Gold1000.DeviceDesc%=AdLibGold_Device, ALG1000
%Gold2000.DeviceDesc%=AdLibGold_Device, ALG2000
%GoldLib.DeviceDesc%=AdLibGold_Device, ALGLIB

[AdLibGold_Device]
AlsoInstall=KS.Registration(ks.inf),WDMAUDIO.Registration(wdmaudio.inf)
CopyFiles=AdLibGold.CopyList
AddReg=AdLibGold.AddReg
LogConfig=ALG.LC0

[AdLibGold_Device.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,ALG.I.Topology
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_FMSynth%,ALG.I.FMSynth
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_FMSynth%,ALG.I.FMSynth
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_MIDI%,ALG.I.MIDI
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_MIDI%,ALG.I.MIDI
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_MIDI%,ALG.I.MIDI

[ALG.I.Wave]
AddReg=ALG.I.Wave.AddReg
[ALG.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AdLibGold.Wave.szPname%

[ALG.I.Topology]
AddReg=ALG.I.Topo.AddReg
;; warning!! must be "Topo" because "Topology" is too long
[ALG.I.Topo.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AdLibGold.Topology.szPname%

[ALG.I.FMSynth]
AddReg=ALG.I.FMSynth.AddReg
[ALG.I.FMSynth.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AdLibGold.FMSynth.szPname%

[ALG.I.MIDI]
AddReg=ALG.I.MIDI.AddReg
[ALG.I.MIDI.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AdLibGold.MIDI.szPname%

[AdLibGold.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,adlibgold.sys
HKR,,NTMPDriver,,"adlibgold.sys"

HKR,Drivers,SubClasses,,"wave,midi,mixer"

HKR,Drivers\wave\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv, Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv

HKR,Drivers\wave\wdmaud.drv,Description,,%AdLibGold.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%WDM_MIDI%
HKR,Drivers\mixer\wdmaud.drv,Description,,%AdLibGold.DeviceDesc%

[DestinationDirs]
AdLibGold.CopyList = 10,system32\drivers ; %SystemRoot%\system32\drivers

[AdLibGold.CopyList]
adlibgold.sys

;;
;; Fixed-resource declaration for the non-PnP Ad Lib Gold card.
;;
;; The card has no Plug-and-Play enumerator, so it installs as a manually
;; created root devnode and its resources come from the INF. The card uses
;; fixed values, so the documented idiom (Win95 MIDI.INF, which installs an
;; OPL FM at base 388h) is a HARDWIRED LogConfig for the immovable range and
;; a NORMAL FactDef alongside. See call/0022 and the host grounding doc
;; non-pnp-inf-install-grounding.md. This single INF serves both Windows 9x
;; (its undecorated section) and Windows 2000 (its .NT section); see call/0023
;; and win2000-install-compatibility.md.
;;
;; The GoldLib under test uses I/O 388h, IRQ 7, DMA 1. The card decodes 16
;; ports from 388h (base+0 through base+0Eh): OPL3 and Control Chip at
;; base+0..3, MMA (YMZ263) digital audio and MIDI at base+0..0Eh. So the
;; claimed range is 388h-397h, not the 8 ports the earlier INF claimed.
;;
[ALG.LC0]
ConfigPriority=HARDWIRED
IOConfig=388-397(ffff::)
IRQConfig=7
DMAConfig=1

[AdLibGold_Device.FactDef]
ConfigPriority=NORMAL
IOConfig=388-397
IRQConfig=7
DMAConfig=1

;;**************** NT Install ****************

[AdLibGold_Device.NT]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=AdLibGold.CopyList
AddReg=AdLibGold.AddReg
LogConfig=ALG.LC0

[AdLibGold_Device.NT.FactDef]
ConfigPriority=NORMAL
IOConfig=388-397
IRQConfig=7
DMAConfig=1

[AdLibGold_Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_Wave%,ALG.I.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_Topology%,ALG.I.Topology
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_FMSynth%,ALG.I.FMSynth
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_FMSynth%,ALG.I.FMSynth
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_MIDI%,ALG.I.MIDI
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_MIDI%,ALG.I.MIDI
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_MIDI%,ALG.I.MIDI

[AdLibGold_Device.NT.Services]
AddService = adlibgold, 0x00000002, AdLibGold_Service_Inst

[AdLibGold_Service_Inst]
DisplayName    = %AdLibGold.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\system32\drivers\adlibgold.sys

[Strings]
MfgName="Ad Lib Inc."
DiskDescription="Ad Lib Gold WDM Audio Driver Disk"
AdLibGold.DeviceDesc="Ad Lib Gold Sound Card"
Gold1000.DeviceDesc="Ad Lib Gold 1000 Sound Card"
Gold2000.DeviceDesc="Ad Lib Gold 2000 Sound Card"
GoldLib.DeviceDesc="GoldLib (Ad Lib Gold 1000 clone)"

AdLibGold.Wave.szPname="Ad Lib Gold Audio"
AdLibGold.Topology.szPname="Ad Lib Gold Mixer"
AdLibGold.FMSynth.szPname="Ad Lib Gold FM Synthesizer"
AdLibGold.MIDI.szPname="Ad Lib Gold MIDI"

MediaCategories="SYSTEM\CurrentControlSet\Control\MediaCategories"
WDM_MIDI="WDM-based Device"

Proxy.CLSID=        "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO=   "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER=  "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE= "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSNAME_Wave="Wave"
KSNAME_Topology="Topology"
KSNAME_FMSynth="FMSynth"
KSNAME_MIDI="MIDI"

AdLibGold.SvcDesc = "Ad Lib Gold WDM Audio Driver"
